# SettleSherlock - example configuration
#
# Copy to .env and fill in real values locally.
# NEVER commit .env.
#
# The deterministic investigation works without an API key.

# Frontend / local backend proxy
SETTLESHERLOCK_BACKEND_URL=http://127.0.0.1:8010

# Optional LLM narrative layer
SETTLESHERLOCK_LLM_ENABLED=false
SETTLESHERLOCK_LLM_PROVIDER=anthropic
SETTLESHERLOCK_LLM_MODEL=claude-opus-5
SETTLESHERLOCK_LLM_FALLBACK_MODEL=

# Generation limits
SETTLESHERLOCK_LLM_MAX_TOKENS=8000
SETTLESHERLOCK_LLM_TIMEOUT_SECONDS=60

# Anthropic credential - NEVER commit the real key
ANTHROPIC_API_KEY=

# Set to 1 to force deterministic fallback diagnosis
DISABLE_AI=0
