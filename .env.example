# SettleSherlock Investigation AI — example configuration.
#
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.
# The deterministic investigation works with none of these set.

# ---------------------------------------------------------------------------
# Optional LLM narrative layer
# ---------------------------------------------------------------------------
# Master switch. When false/unset, no LLM is contacted and the report contains
# only deterministic analysis.
SETTLESHERLOCK_LLM_ENABLED=false

# Supported values: anthropic | none
SETTLESHERLOCK_LLM_PROVIDER=anthropic

# Model used for narrative generation.
SETTLESHERLOCK_LLM_MODEL=claude-opus-5

# Optional: on a policy refusal, retry the same request server-side on this
# model instead of dropping the narrative. Leave blank to disable.
SETTLESHERLOCK_LLM_FALLBACK_MODEL=

# Generation limits.
SETTLESHERLOCK_LLM_MAX_TOKENS=8000
SETTLESHERLOCK_LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Credentials — read by the Anthropic SDK, never by this codebase directly.
# ---------------------------------------------------------------------------
# Put your real key in `.env` (git-ignored) or your shell environment.
ANTHROPIC_API_KEY=
