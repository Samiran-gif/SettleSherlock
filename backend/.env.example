# Copy to .env and adjust as needed.

PROJECT_NAME=SettleSherlock
VERSION=0.1.0

HOST=0.0.0.0
PORT=8000
DEBUG=True

API_V1_PREFIX=/api/v1

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- AI explanation layer ---
# Any OpenAI-compatible chat-completions provider. Defaults target Groq's free
# tier; for Gemini set:
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-2.0-flash
#
# Leave AI_API_KEY empty to run without AI: the explanation endpoint then
# returns an honest deterministic fallback instead of failing.
# NEVER commit a real key - .env is gitignored, .env.example is not.
AI_ENABLED=True
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=15.0
AI_MAX_TOKENS=320
